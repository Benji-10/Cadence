// Prisma schema for the Cadence intelligent calendar.
// Works with both SQLite (local dev) and PostgreSQL (Neon production).
//
// For local dev: DATABASE_URL="file:./dev.db" (SQLite, default)
// For Neon production: DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.neon.tech/db?sslmode=require&pgbouncer=true"
//   ↑ Use the POOLED connection (host contains "-pooler"), not the direct one.
//
// All JSON-like fields are stored as String (TEXT/VARCHAR) for compatibility
// across both providers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Calendar {
  id        String   @id @default(cuid())
  name      String
  color     String
  kind      String   @default("personal")
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  location    String?
  notes       String?

  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false)
  timezone    String?

  icsUid      String?  @unique

  calendarId  String
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  category    String   @default("other")
  flexibility String   @default("movable")
  locationType String  @default("any")
  minChunkMins Int     @default(60)
  allowOverlap Boolean @default(true)
  priority    Int      @default(0)
  travelMins  Int      @default(0)

  color       String?

  alerts      String   @default("[]")
  recurrence  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([calendarId])
  @@index([start])
}
